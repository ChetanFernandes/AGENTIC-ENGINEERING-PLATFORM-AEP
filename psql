CREATE TABLE episodic_memory_embeddings (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id TEXT NOT NULL,
    execution_id TEXT NOT NULL,
    thread_id TEXT NOT NULL,
    user_request TEXT,
    agent TEXT,
    messages JSONB,
    artifacts_id JSONB,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    embedding VECTOR(1536)
)

CREATE TABLE episodic_execution_in_progress (
            execution_id TEXT PRIMARY KEY,
			user_id TEXT NOT NULL,
			thread_id TEXT NOT NULL,
			user_request TEXT,
			messages JSONB NOT NULL DEFAULT '[]'::jsonb,
			updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);


CREATE INDEX episodic_memory_embedding_idx ON episodic_memory_embeddings USING hnsw (embedding vector_cosine_ops);

ALTER TABLE episodic_memory_embeddings ADD CONSTRAINT unique_execution_id UNIQUE (execution_id); 

CREATE INDEX episodic_memory_user_id_idx ON episodic_memory_embeddings (user_id)

